# Template only. Spring Boot does not automatically load .env files.
# Copy these names into your process environment; never commit real values.
DB_URL=jdbc:postgresql://127.0.0.1:55432/evcharging
DB_USERNAME=evcharging
DB_PASSWORD=replace_with_a_unique_database_password
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=local
APP_ADMIN_EMAIL=replace_with_your_administrator_email
APP_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters
PAYMENT_MODE=mock
PAYMENT_GATEWAY=stripe
NOTIFICATION_MODE=mock
NOTIFICATION_TYPE=email
APP_DEMO_MODE=false
# Docker Compose reads .env automatically. Spring Boot only reads the environment.
# For HTTPS deployments set SPRING_PROFILES_ACTIVE=prod and SERVER_ADDRESS=0.0.0.0
# behind a TLS reverse proxy; the production session cookie is always Secure.
# Render uses the committed render.yaml instead of this local Compose template.
# It injects DB_HOST/DB_PORT/DB_NAME/DB_USERNAME/DB_PASSWORD from a NEW cloud DB
# and activates prod,render. Never paste the local EVCHARGING credentials there.
